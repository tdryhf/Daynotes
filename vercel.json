{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/ai/*.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/keepalive", "schedule": "17 3 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
