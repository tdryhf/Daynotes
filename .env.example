# Optional: point this build at a different Supabase project. Without these values the app uses the
# shared Daybook backend configured in src/config.ts. Use the public anon/publishable key only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-side Groq key for note refinement and the Daybook assistant. Do not prefix with VITE_.
GROQ_API_KEY=your-groq-api-key
