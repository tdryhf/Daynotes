# Optional shared cloud sync. Without these values, Daybook works on this device.
# For a shared, passwordless family space, use a dedicated public Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-side Groq key for note refinement and the Daybook assistant. Do not prefix with VITE_.
GROQ_API_KEY=your-groq-api-key
